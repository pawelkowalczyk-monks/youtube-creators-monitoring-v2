# Project-Specific Inputs & Outputs
# Keep sample.xlsx and .gitkeep, but ignore other developer data in inputs
inputs/*
!inputs/sample.xlsx
!inputs/sample2.xlsx
!inputs/sample3.xlsx
!inputs/.gitkeep

# Ignore generated outputs, keeping only structure if desired
output/*
!output/.gitkeep
!output/sampleoutput.txt

